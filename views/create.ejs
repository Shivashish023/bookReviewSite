<!DOCTYPE html>
<html>
<head>
	<title>Book Review Form</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	<link rel="stylesheet" href="styles/create.css">
</head>
<body>
	<nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <p class="navbar-bar" style="font-size: 40px;font-weight: 700;">BookHub<svg style="margin-left: 5px;"  xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-book" viewBox="0 0 16 16">
                <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"/></p>
              </svg>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo02" aria-controls="navbarTogglerDemo02" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarTogglerDemo02">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <form action="/" method="get">
                    <button class="nav-link " >Home</button>
                </form>
              </li>
              <li class="nav-item">
                <form action="/reviews" method="post">    
                    <button class="nav-link " >Your Reviews</button>
                </form>
              </li>
              <li class="nav-item">
                <form action="/create" method="get">
                    <button class="nav-link active" aria-current="page">Create</button>
                </form>
              </li>
            </ul>
            <form class="d-flex" role="search" action="/search" method="post">
              <input class="form-control me-2" name="searched" type="search" placeholder="Search" aria-label="Search">
              <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
          </div>
        </div>
      </nav>
      <% if(locals.info) {%>
        <h1 class="heading">Write your Review</h1>
	<form action="/update" method="post" class="cr">
		<label for="name">Book Name:</label>
		<input type="text" id="name" name="name" value="<%= info.name %>">

		<label for="author">Author:</label>
		<input type="text" id="author" name="author" value="<%= info.author %>" >

		<label for="rating">Rating (1-10):</label>
		<input type="number" id="rating" name="rating" min="1" max="10" value="<%= info.rating %>" >

		<label for="isbn">ISBN:</label>
		<input type="text" id="isbn" name="isbn" value="<%= info.isbn %>" >

		<label for="description">Book Description:</label>
		<textarea id="description" name="description"  ><%= info.description %></textarea>

    <button  class="boton" value="<%= info.id %>" name="updateid" type="submit"><%= but %> Review</button>
	</form>
        
        <%} else{ %>
	<h1 class="heading">Write your Review</h1>
	<form action="/submit" method="post" class="cr">
		<label for="name">Book Name:</label>
		<input type="text" id="name" name="name" required>

		<label for="author">Author:</label>
		<input type="text" id="author" name="author" required>

		<label for="rating">Rating (1-10):</label>
		<input type="number" id="rating" name="rating" min="1" max="10" required>

		<label for="isbn">ISBN:</label>
		<input type="number" id="isbn" name="isbn" required>

		<label for="description">Book Description:</label>
		<textarea id="description" name="description" required></textarea>

    <button  class="boton"   type="submit"><%= but %> Review</button>
	</form>
  <% } %>
</body>
</html>